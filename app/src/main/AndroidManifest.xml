<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 新しいバージョンの確認（GitHub Releases API）のためだけに使う -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- オンボーディングで電池の最適化からの除外を依頼する -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ランチャーに表示されるアプリ・ホームアプリ・メールアプリの取得に使う（QUERY_ALL_PACKAGES は使わない） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- メールアプリを監視対象の候補から除外するために使う -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- スヌーズ用ゲートの「開く」で URL を開いたブラウザのパッケージを調べるために使う -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".MemoryGateApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MemoryGate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MemoryGate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ゲート画面。最近のタスクに出さず、専用タスクで 1 つだけ表示する -->
        <activity
            android:name=".gate.GateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.memorygate.gate"
            android:theme="@style/Theme.MemoryGate" />

        <!-- スヌーズ用ゲート。通常のゲートとは別のタスクで 1 つだけ表示する -->
        <activity
            android:name=".gate.SnoozeGateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.memorygate.snooze"
            android:theme="@style/Theme.MemoryGate" />

        <service
            android:name=".service.GateAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gate_accessibility_service" />
        </service>
    </application>

</manifest>
